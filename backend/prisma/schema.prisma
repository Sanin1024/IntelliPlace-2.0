  @@map("career_tracks")
}

model StudentCareerTrack {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  student     User     @relation("MechCareerTrackStudent", fields: [studentId], references: [id], onDelete: Cascade)
  careerTrackId String @map("career_track_id")
  careerTrack CareerTrack @relation(fields: [careerTrackId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime @default(now()) @map("enrolled_at")
  progress    Float    @default(0)

  @@unique([studentId, careerTrackId])
  @@map("student_career_tracks")
