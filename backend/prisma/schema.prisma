// ============================================================
// MOCK TESTS & ATTEMPTS
// ============================================================

model MockTest {
  id                 String             @id @default(uuid())
  title              String
  description        String?
  durationMins       Int                @default(30) @map("duration_mins")
  batchId            Int?               @map("batch_id")
  batch              Batch?             @relation(fields: [batchId], references: [id])
  availableFrom      DateTime?          @map("available_from")
  availableUntil     DateTime?          @map("available_until")
  maxAttempts        Int                @default(1) @map("max_attempts")
  createdBy          String             @map("created_by")
  creator            User               @relation("MockTestCreator", fields: [createdBy], references: [id])
  createdAt          DateTime           @default(now()) @map("created_at")
  isActive           Boolean            @default(true) @map("is_active")
  status             TestStatus         @default(draft)
  shuffleQuestions   Boolean            @default(false) @map("shuffle_questions")
  shuffleOptions     Boolean            @default(false) @map("shuffle_options")
  negativeMarks      Float              @default(0) @map("negative_marks")
  generationMode     TestGeneration     @default(fixed) @map("generation_mode")
  questionRules      Json?              @map("question_rules")
  showResults        ShowResultsMode    @default(after_submit) @map("show_results")
  securityConfig     Json?              @map("security_config")
  resultsPublishedAt DateTime?          @map("results_published_at")
  questions          MockTestQuestion[]
  attempts           TestAttempt[]

  @@index([batchId])
  @@map("mock_tests")
}

model MockTestQuestion {
  testId     String           @map("test_id")
  test       MockTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  questionId String           @map("question_id")
  question   AptitudeQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  marks      Int              @default(1)

  @@id([testId, questionId])
  @@map("mock_test_questions")
}

model TestAttempt {
  id                       String                    @id @default(uuid())
  testId                   String?                   @map("test_id")
  test                     MockTest?                 @relation(fields: [testId], references: [id])
  studentId                String                    @map("student_id")
  student                  User                      @relation(fields: [studentId], references: [id])
  attemptType              AttemptType               @default(mock) @map("attempt_type")
  status                   AttemptStatus             @default(in_progress)
  startTime                DateTime                  @default(now()) @map("start_time")
  endTime                  DateTime?                 @map("end_time")
  score                    Float?
  totalMarks               Float?                    @map("total_marks")
  submissionIdempotencyKey String?                   @unique @map("submission_idempotency_key")
  lastQuestionIndex        Int?                      @map("last_question_index")
  questionOrder            Json?                     @map("question_order")
  optionOrders             Json?                     @map("option_orders")
  extraTimeMins            Int                       @default(0) @map("extra_time_mins")
  evaluationStatus         AttemptEvaluationStatus   @default(pending) @map("evaluation_status")
  clientSubmittedAt        DateTime?                 @map("client_submitted_at")
  processedAt              DateTime?                 @map("processed_at")
  answers                  StudentAnswer[]
  preliminaryAssessment    PreliminaryAssessment?
  integrityFlags           AssessmentIntegrityFlag[]
  skillEvidence            SkillEvidence[]
  activities               AttemptActivityLog[]

  @@index([studentId])
  @@index([testId])
  @@index([studentId, status])
  @@index([testId, status])
  @@map("test_attempts")
}

model StudentAnswer {
  attemptId       String           @map("attempt_id")
  attempt         TestAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId      String           @map("question_id")
  question        AptitudeQuestion @relation(fields: [questionId], references: [id])
  selectedOption  String?          @map("selected_option")
  selectedOptions String[]         @default([]) @map("selected_options")
  isCorrect       Boolean?         @map("is_correct")
  marksAwarded    Float?           @map("marks_awarded")
  savedAt         DateTime         @default(now()) @map("saved_at")

  @@id([attemptId, questionId])
  @@map("student_answers")
}

// ============================================================
// CODING SUBMISSIONS
