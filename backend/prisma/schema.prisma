// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id             String               @id @default(uuid())
  title          String
  message        String
  category       NotificationCategory @default(system_announcement)
  priority       NotificationPriority @default(normal)
  entityType     String?              @map("entity_type")
  entityId       String?              @map("entity_id")
  idempotencyKey String?              @unique @map("idempotency_key")
  scheduledAt    DateTime?            @map("scheduled_at")
  createdBy      String?              @map("created_by")
  creator        User?                @relation("NotificationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  scheduleId     String?              @map("schedule_id")
  schedule       NotificationSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now()) @map("created_at")
  recipients     NotificationRecipient[]

  @@index([category])
  @@index([priority])
  @@map("notifications")
}

model NotificationRecipient {
  id             String                     @id @default(uuid())
  notificationId String                     @map("notification_id")
  notification   Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String                     @map("user_id")
  user           User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveryStatus NotificationDeliveryStatus @default(pending) @map("delivery_status")
  channel        NotificationChannel        @default(in_app) @map("channel")
  retryCount     Int                        @default(0) @map("retry_count")
  lastError      String?                    @map("last_error")
  isRead         Boolean                    @default(false) @map("is_read")
  sentAt         DateTime?                  @map("sent_at")
  readAt         DateTime?                  @map("read_at")
  createdAt      DateTime                   @default(now()) @map("created_at")

  @@unique([notificationId, userId, channel])
  @@index([userId])
  @@index([userId, isRead])
  @@index([deliveryStatus, channel])
  @@map("notification_recipients")
}

model NotificationPreference {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefs     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notification_preferences")
}

model PushSubscription {
  id        String   @id @default(uuid())
