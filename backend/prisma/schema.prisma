// Mechanical Engineering Subjects
model EngineeringSubject {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  category    String   // e.g., "Thermal", "Design", "Manufacturing"
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  topics      EngineeringTopic[]
  questions   MechanicalQuestion[]

  @@map("engineering_subjects")
}

model EngineeringTopic {
  id          Int      @id @default(autoincrement())
  subjectId   Int      @map("subject_id")
  subject     EngineeringSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([subjectId, name])
  @@map("engineering_topics")
}

// Career Tracks for Mechanical Engineering
model CareerTrack {
  id          String          @id @default(uuid())
  name        String          @unique
  trackType   CareerTrackType @map("track_type")
  description String?
  targetRoles String[]        @map("target_roles")
  requiredSkills String[]     @map("required_skills")
  recommendedSoftware String[] @map("recommended_software")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt      @map("updated_at")

