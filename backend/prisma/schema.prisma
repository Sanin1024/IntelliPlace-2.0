generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS — lowercase to match all controller/seed code
// ============================================================

enum Role {
  student
  po
  trainer
  admin
}

enum KnowledgeLevel {
  beginner
  intermediate
  advanced
}

enum PlacementStatus {
  not_placed
  in_process
  placed
}

enum Difficulty {
  easy
  medium
  hard
}

enum TopicType {
  aptitude
  coding
}

enum AttemptType {
  mock
  practice
}

enum AttemptStatus {
  in_progress
  submitted
  expired
}

enum AssessmentStatus {
  pending_scheduling
  scheduled
  in_progress
  completed
  overdue
  rescheduled
  absent
  evaluation_pending
}

enum DriveStatus {
  draft
  published
  active
  closed
  cancelled
  withdrawn
  archived
}

enum RegistrationCloseReason {
  deadline
  company_closed
  capacity_full
  cancelled
  withdrawn
  closed_manually
}

enum ApplicationStatus {
  applied
  shortlisted
  selected
  rejected
  withdrawn
}

enum DriveChangeType {
  schedule_change
  venue_change
  meeting_link_change
  round_change
  other
}

enum DriveNotificationType {
  new_drive
  deadline_reminder
  schedule_change
  cancellation
  withdrawal
  registration_closed
  application_update
}

enum DriveNotificationStatus {
  pending
  sent
  failed
  suppressed
}

enum NotificationCategory {
  placement_drive
  application
  interview
  deadline
  eligibility
  company_update
  system_announcement
}

enum NotificationPriority {
  critical
  high
  normal
  low
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  read
  suppressed
}

enum NotificationChannel {
  in_app
  email
  push
}

enum ScheduleStatus {
  pending
  processing
  completed
  cancelled
}

enum ProfileVerificationStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REVISION_REQUIRED
}

enum DatasetApprovalStatus {
  NOT_GENERATED
  GENERATED
  INCOMPLETE
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  SHARED
  REVOKED
}

enum RoundStatus {
  pending
  qualified
  rejected
  skipped
}

enum OfferStatus {
  issued
  pending
  accepted
  rejected
  withdrawn
  expired
  revoked
}

enum EmploymentType {
  internship
  internship_ppo
  full_time
  part_time
  contract
  apprenticeship
}

enum AcademicVerificationStatus {
  pending
  verified
  rejected
  requires_correction
}

enum SemesterResultStatus {
  published
  pending
  unavailable
}

enum BacklogStatus {
  active
  cleared
}

enum TransferStatus {
  pending
  approved
  rejected
}

enum CorrectionRequestStatus {
  pending
  approved
  rejected
}

enum EvaluationStatus {
  ELIGIBLE
  INELIGIBLE
  PENDING_VERIFICATION
  MANUAL_OVERRIDE
}

enum ShortlistAction {
  shortlist
  select
  reject
}

enum TrainingActivityStatus {
  scheduled
  completed
  pending
  overdue
  missed
  cancelled
  rescheduled
}

enum ModuleLevel {
  beginner
  intermediate
  advanced
}

enum ModuleProgressStatus {
  not_started
  in_progress
  completed
  failed
}

enum ContentStatus {
  updated
  under_review
  outdated
}

enum ResourceVisibility {
  public
  institution
  training_group
  restricted
}

enum LinkStatus {
  ok
  broken
  unknown
}

enum TestStatus {
  draft
  published
  in_progress
  completed
  archived
}

enum TestGeneration {
  fixed
  balanced
}

enum ShowResultsMode {
  after_submit
  after_deadline
  manual
}

enum AttemptEvaluationStatus {
  pending
  evaluated
  eval_failed
}

enum ActivityEventType {
  tab_switch
  focus_loss
  window_blur
  warning_shown
  session_recovered
  autosave_failed
  submission_retry
}

enum OutputNormalization {
  exact
  trim_lines
  trim_all
}

enum TrainerRole {
  primary
  assistant
}

enum InterventionSeverity {
  low
  medium
  high
}

enum InterventionStatus {
  open
  monitoring
  resolved
}

enum TaskStatus {
  pending
  acknowledged
  completed
}

// ============================================================
// USERS & PROFILES
// ============================================================

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(student)
  isActive     Boolean  @default(true) @map("is_active")
  tokenVersion Int      @default(0) @map("token_version")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  studentProfile         StudentProfile?
  uploadedResources      Resource[]              @relation("ResourceUploader")
  createdMockTests       MockTest[]              @relation("MockTestCreator")
  testAttempts           TestAttempt[]
  codingSubmissions      CodingSubmission[]
  prepPlanEnrollments    StudentPreparationEnrollment[] @relation("PrepPlanStudent")
  notificationRecipients NotificationRecipient[]
  createdNotifications   Notification[]          @relation("NotificationCreator")
  targetCompanies        StudentTargetCompany[]
  studentResumeData      StudentResumeData?
  auditLogs              AuditLog[]              @relation("AuditActor")
  assessmentsAssigned    PreliminaryAssessment[]
  slotsCreated           AssessmentSlot[]
  settingsUpdated        SystemSetting[]         @relation("SettingUpdater")
  driveApplications      DriveApplication[]
  passwordResetTokens    PasswordResetToken[]
  eligibilityEvaluations EligibilityEvaluation[]
  supplementaryExams     SupplementaryExam[]
  educationHistory       EducationHistory[]
  shortlistDecisions     ShortlistDecision[]
  createdSessions        TrainingSession[]       @relation("SessionCreator")
  trainingAssignments    TrainingAssignment[]    @relation("TrainingAssignee")
  resourceAccessLogs     ResourceAccessLog[]     @relation("ResourceAccessor")
  moduleProgress         ModuleProgress[]        @relation("ModuleLearner")
  videoProgress          VideoProgress[]         @relation("VideoWatcher")
  competencies           CompetencyRecord[]      @relation("CompetencyHolder")
  declaredSkills         DeclaredSkill[]
  skillEvidence          SkillEvidence[]
  integrityFlags         AssessmentIntegrityFlag[]
  recommendations        StudentRecommendation[]
  readinessSnapshots     ReadinessSnapshot[]
  careerGoal             CareerGoal?
  attemptActivityLogs    AttemptActivityLog[]
  resumeVersions         ResumeVersion[]         @relation("ResumeOwner")
  exams                  AcademicExam[]            @relation("ExamStudent")
  availability           InterviewerAvailability[] @relation("AvailabilityInterviewer")
  studentInterviews      MockInterview[]           @relation("InterviewStudent")
  interviewerSlots       MockInterview[]           @relation("Interviewer")
  notificationPreferences NotificationPreference?
  pushSubscriptions       PushSubscription[]
  offers                  Offer[]                   @relation("OfferStudent")
  trainerProfile          TrainerProfile?
  trainerAssignments      TrainerBatchAssignment[]    @relation("TrainerAssignee")
  sessionAssignments      TrainerSessionAssignment[]  @relation("SessionTrainer")
  feedbackGiven           TrainerFeedback[]           @relation("FeedbackStudent")
  feedbackReceived        TrainerFeedback[]           @relation("FeedbackTrainer")
  tasks                   TrainerTask[]               @relation("TaskTrainer")
  interventionsAssigned   StudentIntervention[]       @relation("InterventionTrainer")
  interventionsReceived   StudentIntervention[]       @relation("InterventionStudent")
  evaluations             TrainerEvaluation[]         @relation("EvalTrainer")
  consents                ConsentRecord[]             @relation("ConsentStudent")
  dataRequests            DataRequest[]               @relation("RequestingStudent")
  accessLogs              DataAccessLog[]             @relation("AccessActor")
  targetAccessLogs        DataAccessLog[]             @relation("AccessTarget")
  sharedLogs              DataShareLog[]              @relation("SharedStudent")
  verifiedProfiles        StudentProfile[]                    @relation("ProfileVerifier")
  verificationHistories   StudentProfileVerificationHistory[] @relation("OfficerVerificationHistories")
  requirementTemplates    CompanyDataRequirementTemplate[]    @relation("TemplateCreator")
  reviewedDatasets        GeneratedPlacementDataset[]         @relation("DatasetReviewer")
  approvedDatasets        GeneratedPlacementDataset[]         @relation("DatasetApprover")
  exportedDatasets        DatasetExportHistory[]              @relation("DatasetExporter")

  mechCareerTracks              StudentCareerTrack[]      @relation("MechCareerTrackStudent")
  mechProjectSubmissions        ProjectSubmission[]     @relation("MechProjectStudent")
  mechPracticalSubmissions      PracticalSubmission[] @relation("MechPracticalStudent")
  mechMockInterviewsStudent     MockInterviewSession[] @relation("MechMockInterviewStudent")
  mechMockInterviewsInterviewer MockInterviewSession[] @relation("MechMockInterviewer")
  ecePracticalSubmissions       ECEPracticalSubmission[] @relation("ECEPracticalStudent")
  eeePracticalSubmissions       EEEPracticalSubmission[] @relation("EEEPracticalStudent")
  itPracticalSubmissions        ITPracticalSubmission[]  @relation("ITPracticalStudent")

  @@map("users")
}

model Branch {
  id               Int                     @id @default(autoincrement())
  name             String                  @unique
  code             String?                 @unique @map("code") // e.g., "CS", "CAID", "CSBS"
  isActive         Boolean                 @default(true) @map("is_active")
  aliases          String[]                @default([])
  students         StudentProfile[]
  companies        CompanyEligibleBranch[]
  driveEligibility DriveEligibleBranch[]

  @@map("branches")
}

model Batch {
  id               Int                  @id @default(autoincrement())
  name             String               @unique
  graduationYear   Int                  @map("graduation_year")
  students         StudentProfile[]
  mockTests        MockTest[]
  driveEligibility DriveEligibleBatch[]
  trainerAssignments TrainerBatchAssignment[]
  timetable          AcademicTimetable[]
  resources          Resource[]

  @@map("batches")
}

model StudentProfile {
  userId            String                     @id @map("user_id")
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  universityId      String?                    @unique @map("university_id")
  ktuid             String?                    @unique @map("ktuid") // e.g., KSD23CS007, LKSD23CS134
  entryType         String                     @default("REGULAR") @map("entry_type") // REGULAR | LATERAL
  admissionYear     Int?                       @map("admission_year")
  graduatingBatch   String?                    @map("graduating_batch") // e.g., "2027"
  academicScheme    String                     @default("APJKTU_2019") @map("academic_scheme")
  currentSemester   Int?                       @map("current_semester")
  branchId          Int?                       @map("branch_id")
  branch            Branch?                    @relation(fields: [branchId], references: [id])
  batchId           Int?                       @map("batch_id")
  batch             Batch?                     @relation(fields: [batchId], references: [id])
  section           String?                    @map("section") // e.g., "CSA", "CSB", "NOT_APPLICABLE"
  knowledgeLevel    KnowledgeLevel             @default(beginner) @map("knowledge_level")
  cgpa              Float?
  cgpaVerified      Boolean                    @default(false) @map("cgpa_verified")
  academicStatus    AcademicVerificationStatus @default(pending) @map("academic_status")
  academicUpdatedAt DateTime?                  @map("academic_updated_at")
  profileUpdatedAt  DateTime?                  @map("profile_updated_at")
  placementStatus   PlacementStatus            @default(not_placed) @map("placement_status")
  resumeUrl         String?                    @map("resume_url")
  targetRole        String?                    @map("target_role")
  notificationPrefs Json?                      @map("notification_prefs")
  createdAt         DateTime                   @default(now()) @map("created_at")
  updatedAt         DateTime                   @updatedAt @map("updated_at")

  // Master Profile Fields (Sections A - J)
  masterStatus        ProfileVerificationStatus  @default(NOT_STARTED) @map("master_status")
  verificationComments String?                   @map("verification_comments")
  verifiedBy          String?                    @map("verified_by")
  verifier            User?                      @relation("ProfileVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  verifiedAt          DateTime?                  @map("verified_at")
  submittedAt         DateTime?                  @map("submitted_at")
  completionPercentage Float                     @default(0.0) @map("completion_percentage")

  // Section A: Personal Information
  dob                 DateTime?
  gender              String?
  personalEmail       String?                    @map("personal_email")
  collegeEmail        String?                    @map("college_email")
  phone               String?
  alternatePhone      String?                    @map("alternate_phone")
  residentialAddress  String?                    @map("residential_address")
  permanentAddress    String?                    @map("permanent_address")
  city                String?
  district            String?
  state               String?
  pincode             String?
  photoUrl            String?                    @map("photo_url")

  // Section B: Academic Information additions
  collegeName         String?                    @default("LBS College of Engineering, Kasaragod") @map("college_name")
  universityAffiliation String?                  @default("APJ Abdul Kalam Technological University") @map("university_affiliation")
  degree              String?                    @default("B.Tech") @map("degree")
  overallPercentage   Float?                     @map("overall_percentage")

  // Section C: Previous Educational Qualifications
  tenthSchool         String?                    @map("tenth_school")
  tenthBoard          String?                    @map("tenth_board")
  tenthYear           Int?                       @map("tenth_year")
  tenthPercentage     Float?                     @map("tenth_percentage")
  twelfthSchool       String?                    @map("twelfth_school")
  twelfthBoard        String?                    @map("twelfth_board")
  twelfthStream       String?                    @map("twelfth_stream")
  twelfthYear         Int?                       @map("twelfth_year")
  twelfthPercentage   Float?                     @map("twelfth_percentage")
  hasDiploma          Boolean                    @default(false) @map("has_diploma")
  diplomaInstitution  String?                    @map("diploma_institution")
  diplomaBranch       String?                    @map("diploma_branch")
  diplomaYear         Int?                       @map("diploma_year")
  diplomaPercentage   Float?                     @map("diploma_percentage")

  // Section D: Academic Backlog & Gap Information
  activeBacklogs      Int                        @default(0) @map("active_backlogs")
  historicalBacklogs  Int                        @default(0) @map("historical_backlogs")
  clearedBacklogs     Int                        @default(0) @map("cleared_backlogs")
  hasAcademicGaps     Boolean                    @default(false) @map("has_academic_gaps")
  gapDurationMonths   Int?                       @map("gap_duration_months")
  gapReason           String?                    @map("gap_reason")

  // Section G Flag
  internshipNotApplicable Boolean                @default(false) @map("internship_not_applicable")

  // Section I: Professional Information
  careerInterests     String[]                   @default([]) @map("career_interests")
  preferredRoles      String[]                   @default([]) @map("preferred_roles")
  preferredDomains    String[]                   @default([]) @map("preferred_domains")
  preferredLocations  String[]                   @default([]) @map("preferred_locations")
  willingToRelocate   Boolean                    @default(true) @map("willing_to_relocate")
  githubUrl           String?                    @map("github_url")
  linkedinUrl         String?                    @map("linkedin_url")
  portfolioUrl        String?                    @map("portfolio_url")

  // Master Profile Relations
  technicalSkills     StudentTechnicalSkill[]
  projects            StudentProject[]
  internships         StudentInternship[]
  certifications      StudentCertification[]
  documents           StudentDocument[]
  masterVerificationHistory StudentProfileVerificationHistory[]

  semesters           SemesterResult[]
  backlogs            BacklogRecord[]
  transfers           StudentTransfer[]
  correctionRequests  ProfileCorrectionRequest[]
  verificationHistory AcademicVerificationHistory[]

  @@map("student_profiles")
}

model StudentTechnicalSkill {
  id          String         @id @default(uuid())
  studentId   String         @map("student_id")
  student     StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  category    String         // programming_language, framework, library, database, tool, os, cloud, ai_ml
  name        String
  proficiency String         @default("intermediate") // beginner, intermediate, advanced, expert
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([studentId])
  @@map("student_technical_skills")
}

model StudentProject {
  id           String         @id @default(uuid())
  studentId    String         @map("student_id")
  student      StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  title        String
  description  String
  domain       String?
  technologies String[]       @default([])
  duration     String?
  isTeam       Boolean        @default(false) @map("is_team")
  contribution String?
  projectUrl   String?        @map("project_url")
  githubUrl    String?        @map("github_url")
  createdAt    DateTime       @default(now()) @map("created_at")

  @@index([studentId])
  @@map("student_projects")
}

model StudentInternship {
  id             String         @id @default(uuid())
  studentId      String         @map("student_id")
  student        StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  organization   String
  role           String
  type           String         @default("internship") // internship | part_time | full_time
  startDate      DateTime       @map("start_date")
  endDate        DateTime?      @map("end_date")
  durationMonths Int?           @map("duration_months")
  responsibilities String?
  technologies   String[]       @default([])
  certificateUrl String?        @map("certificate_url")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([studentId])
  @@map("student_internships")
}

model StudentCertification {
  id             String         @id @default(uuid())
  studentId      String         @map("student_id")
  student        StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  title          String
  issuer         String
  issueDate      DateTime       @map("issue_date")
  expiryDate     DateTime?      @map("expiry_date")
  credentialId   String?        @map("credential_id")
  verificationUrl String?       @map("verification_url")
  certificateUrl String?        @map("certificate_url")
  category       String         @default("certification") // certification | achievement | competition | workshop
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([studentId])
  @@map("student_certifications")
}

model StudentDocument {
  id          String         @id @default(uuid())
  studentId   String         @map("student_id")
  student     StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  type        String         // resume, tenth_marksheet, twelfth_marksheet, diploma_marksheet, semester_marksheet, consolidated_marksheet, certificate, other
  title       String
  fileUrl     String         @map("file_url")
  fileSize    Int?           @map("file_size")
  mimeType    String?        @map("mime_type")
  verified    Boolean        @default(false)
  verifiedBy  String?        @map("verified_by")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([studentId, type])
  @@map("student_documents")
}

model StudentProfileVerificationHistory {
  id          String                    @id @default(uuid())
  studentId   String                    @map("student_id")
  student     StudentProfile            @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  status      ProfileVerificationStatus
  officerId   String                    @map("officer_id")
  officer     User                      @relation("OfficerVerificationHistories", fields: [officerId], references: [id])
  comments    String?
  sections    Json?                     // Section-wise verification state: { personal: true, academic: true, etc. }
  createdAt   DateTime                  @default(now()) @map("created_at")

  @@index([studentId])
  @@map("student_profile_verification_history")
}

// ============================================================
// TOPICS & QUESTIONS
// ============================================================

model Topic {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  type              TopicType
  aptitudeQuestions AptitudeQuestion[]
  codingProblems    CodingProblem[]
  resources         Resource[]
  companyTopics     CompanyTopic[]
  trainingSessions  TrainingSession[]
  learningModules   LearningModule[]

  @@map("topics")
}

model AptitudeQuestion {
  id             String             @id @default(uuid())
  topicId        Int                @map("topic_id")
  topic          Topic              @relation(fields: [topicId], references: [id])
  difficulty     Difficulty         @default(easy)
  questionText   String             @map("question_text")
  optionA        String             @map("option_a")
  optionB        String             @map("option_b")
  optionC        String             @map("option_c")
  optionD        String             @map("option_d")
  correctOption  String
  isMultiSelect  Boolean            @default(false) @map("is_multi_select")
  correctOptions String[]           @default([]) @map("correct_options")
  explanation    String?
  createdAt      DateTime           @default(now()) @map("created_at")
  mockTests      MockTestQuestion[]
  studentAnswers StudentAnswer[]
  versions       QuestionVersion[]

  @@index([topicId])
  @@map("aptitude_questions")
}

model CodingProblem {
  id                  String                      @id @default(uuid())
  topicId             Int                         @map("topic_id")
  topic               Topic                       @relation(fields: [topicId], references: [id])
  difficulty          Difficulty                  @default(easy)
  title               String
  slug                String                      @unique
  description         String
  inputFormat         String?                     @map("input_format")
  outputFormat        String?                     @map("output_format")
  constraints         String?
  sampleInput         String                      @map("sample_input")
  sampleOutput        String                      @map("sample_output")
  tags                String[]
  companyTags         String[]                    @default([]) @map("company_tags")
  timeLimit           Int                         @default(2000) @map("time_limit")
  memoryLimit         Int                         @default(256) @map("memory_limit")
  editorial           String?
  sourceUrl           String?                     @map("source_url")
  license             String?
  status              String                      @default("published") // draft, under_review, published, archived
  timeLimitMs         Int                         @default(5000) @map("time_limit_ms")
  outputNormalization OutputNormalization        @default(trim_lines) @map("output_normalization")
  partialMarks        Boolean                     @default(false) @map("partial_marks")
  createdAt           DateTime                    @default(now()) @map("created_at")
  testCases           CodingTestCase[]
  submissions         CodingSubmission[]
  tasks               InterviewPreparationTask[]

  @@index([topicId, difficulty, status])
  @@map("coding_problems")
}

model CodingTestCase {
  id             String        @id @default(uuid())
  problemId      String        @map("problem_id")
  problem        CodingProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String
  expectedOutput String        @map("expected_output")
  isHidden       Boolean       @default(true) @map("is_hidden")

  @@index([problemId])
  @@map("coding_test_cases")
}

// ============================================================
// GLOBAL INTERVIEW PREPARATION
// ============================================================

model InterviewPreparationPlan {
  id          String   @id @default(uuid())
  title       String   @unique
  durationDays Int      @map("duration_days")
  targetRole  String   @map("target_role")
  difficulty  String   @default("medium")
  description String?
  status      String   @default("published")
  createdAt   DateTime @default(now()) @map("created_at")

  tasks       InterviewPreparationTask[]
  enrollments StudentPreparationEnrollment[]

  @@map("interview_preparation_plans")
}

model InterviewPreparationTask {
  id          String   @id @default(uuid())
  planId      String   @map("plan_id")
  plan        InterviewPreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber   Int      @map("day_number")
  problemId   String?  @map("problem_id")
  problem     CodingProblem? @relation(fields: [problemId], references: [id])
  taskType    String   @default("coding") @map("task_type") // coding, reading, mock_interview
  title       String
  description String?
  isRequired  Boolean  @default(true) @map("is_required")

  @@map("interview_preparation_tasks")
}

model StudentPreparationEnrollment {
  id          String   @id @default(uuid())
  studentId   String   @map("student_id")
  student     User     @relation("PrepPlanStudent", fields: [studentId], references: [id], onDelete: Cascade)
  planId      String   @map("plan_id")
  plan        InterviewPreparationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  enrolledAt  DateTime @default(now()) @map("enrolled_at")
  progress    Float    @default(0)

  @@unique([studentId, planId])
  @@map("student_preparation_enrollments")
}

// ============================================================
// COMPANIES
// ============================================================

model Company {
  id               String                  @id @default(uuid())
  name             String                  @unique
  website          String?
  hqLocation       String?                 @map("hq_location")
  contactEmail     String?                 @map("contact_email")
  contactPhone     String?                 @map("contact_phone")
  description      String?
  jobRole          String?                 @map("job_role")
  package          Float?
  eligibilityCgpa  Float?                  @map("eligibility_cgpa")
  driveDate        DateTime?               @map("drive_date")
  syllabusText     String?                 @map("syllabus_text")
  internalNotes    String?                 @map("internal_notes")
  deletedAt        DateTime?               @map("deleted_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  eligibleBranches CompanyEligibleBranch[]
  topics           CompanyTopic[]
  targetStudents   StudentTargetCompany[]
  drives           PlacementDrive[]
  offers           Offer[]                 @relation("OfferCompany")
  sharedLogs       DataShareLog[]          @relation("SharedCompany")

  @@map("companies")
}

model CompanyEligibleBranch {
  companyId String  @map("company_id")
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branchId  Int     @map("branch_id")
