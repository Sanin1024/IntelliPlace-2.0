  @@index([resourceType, category, status])
  @@map("training_resources")
}

model ResourceProvider {
  id              String            @id @default(uuid())
  name            String            @unique
  baseUrl         String            @map("base_url")
  providerType    String            @map("provider_type") // dataset, learning, coding
  integrationType String            @default("manual") @map("integration_type") // api, rss, manual
