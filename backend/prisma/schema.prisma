  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@map("preliminary_assessments")
}

// ============================================================
// PLACEMENT DRIVES & APPLICATIONS
// ============================================================

model PlacementDrive {
  id                      String                   @id @default(uuid())
  companyId               String                   @map("company_id")
  company                 Company                  @relation(fields: [companyId], references: [id])
  title                   String
  jobRole                 String                   @map("job_role")
  jobDescription          String?                  @map("job_description")
  responsibilities        String?
  requiredSkills          String[]                 @map("required_skills")
  qualifications          String?
  experienceRequired      String?                  @map("experience_required")
  employmentType          String                   @default("full_time") @map("employment_type")
  location                String?
  vacancies               Int?
  ctcMin                  Float?                   @map("ctc_min")
  ctcMax                  Float?                   @map("ctc_max")
  monthlySalary           Float?                   @map("monthly_salary")
  stipend                 Float?
  benefits                String?
  selectionProcess        String?                  @map("selection_process")
  minCgpa                 Float?                   @map("min_cgpa")
  maxBacklogs             Int?                     @map("max_backlogs")
  registrationDeadline    DateTime?                @map("registration_deadline")
  registrationClosedAt    DateTime?                @map("registration_closed_at")
  registrationCloseReason RegistrationCloseReason? @map("registration_close_reason")
  status                  DriveStatus              @default(draft)
  rounds                  Json?
  duplicateOverrideReason String?                  @map("duplicate_override_reason")
  conflictOverrideReason  String?                  @map("conflict_override_reason")
  cancelledAt             DateTime?                @map("cancelled_at")
  cancelledBy             String?                  @map("cancelled_by")
  cancellationReason      String?                  @map("cancellation_reason")
  withdrawnAt             DateTime?                @map("withdrawn_at")
  withdrawnBy             String?                  @map("withdrawn_by")
  withdrawalReason        String?                  @map("withdrawal_reason")
  archivedAt              DateTime?                @map("archived_at")
  createdBy               String                   @map("created_by")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  deletedAt               DateTime?                @map("deleted_at")

  eligibleBranches DriveEligibleBranch[]
  eligibleBatches  DriveEligibleBatch[]
  applications     DriveApplication[]
  changeHistory    DriveChangeHistory[]
  notifications    DriveNotification[]
  criteriaVersions DriveEligibilityCriteria[]
  evaluations      EligibilityEvaluation[]
  shortlists       ShortlistDecision[]
  recruitmentRounds RecruitmentRound[]
  offers           Offer[]
  campaign         NotificationCampaign?
  dataRequirement   PlacementDriveDataRequirement?
  generatedDatasets GeneratedPlacementDataset[]

  @@index([status])
  @@index([companyId])
  @@index([registrationDeadline])
  @@map("placement_drives")
}

model CompanyDataRequirementTemplate {
  id          String   @id @default(uuid())
  name        String   @unique
  companyName String?  @map("company_name")
  description String?
  fields      Json     // Array of RequestedFieldDefinition: [{ fieldKey, label, required, order }]
  createdBy   String   @map("created_by")
  creator     User     @relation("TemplateCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("company_data_requirement_templates")
}

model PlacementDriveDataRequirement {
  id          String                 @id @default(uuid())
  driveId     String                 @unique @map("drive_id")
  drive       PlacementDrive         @relation(fields: [driveId], references: [id], onDelete: Cascade)
  fields      Json                   // Array of RequestedFieldDefinition
  instructions String?
  templateId  String?                @map("template_id")
  datasets    GeneratedPlacementDataset[]
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@map("placement_drive_data_requirements")
}

model GeneratedPlacementDataset {
  id            String                 @id @default(uuid())
  requirementId String                 @map("requirement_id")
  requirement   PlacementDriveDataRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  driveId       String                 @map("drive_id")
  drive         PlacementDrive         @relation(fields: [driveId], references: [id], onDelete: Cascade)
  version       Int                    @default(1)
  status        DatasetApprovalStatus  @default(GENERATED)
  scope         String                 @default("applied_students") // applied_students | all_eligible
  totalStudents Int                    @default(0) @map("total_students")
  completeCount Int                    @default(0) @map("complete_count")
  missingCount  Int                    @default(0) @map("missing_count")
  data          Json                   // Generated records: [{ studentId, fields: { [col]: val }, missingFields: [], isComplete: true }]
  reviewComments String?               @map("review_comments")
  reviewedBy    String?                @map("reviewed_by")
  reviewer      User?                  @relation("DatasetReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?              @map("reviewed_at")
  approvedBy    String?                @map("approved_by")
  approver      User?                  @relation("DatasetApprover", fields: [approvedBy], references: [id], onDelete: SetNull)
  approvedAt    DateTime?              @map("approved_at")
  sharedAt      DateTime?              @map("shared_at")
  exportHistory DatasetExportHistory[]
  createdAt     DateTime               @default(now()) @map("created_at")
  updatedAt     DateTime               @updatedAt @map("updated_at")

  @@index([driveId, version])
  @@index([status])
  @@map("generated_placement_datasets")
}

model DatasetExportHistory {
  id          String                    @id @default(uuid())
  datasetId   String                    @map("dataset_id")
  dataset     GeneratedPlacementDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  format      String                    // xlsx, csv, pdf
  exportedBy  String                    @map("exported_by")
  exporter    User                      @relation("DatasetExporter", fields: [exportedBy], references: [id])
  sharedWith  String?                   @map("shared_with") // recipient/destination
  exportedAt  DateTime                  @default(now()) @map("exported_at")

  @@map("dataset_export_history")
}

model NotificationCampaign {
  id        String                 @id @default(uuid())
  driveId   String                 @unique @map("drive_id")
  drive     PlacementDrive         @relation(fields: [driveId], references: [id], onDelete: Cascade)
  schedules NotificationSchedule[]

  @@map("notification_campaigns")
}

model NotificationSchedule {
  id           String               @id @default(uuid())
  campaignId   String               @map("campaign_id")
  campaign     NotificationCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  reminderType String               @map("reminder_type") // initial, 7d, 3d, 24h, 6h, 1h, manual
  scheduledAt  DateTime             @map("scheduled_at")
  status       ScheduleStatus       @default(pending)
  processedAt  DateTime?            @map("processed_at")
  lockedAt     DateTime?            @map("locked_at") // For worker locking

  notifications Notification[]

  @@index([status, scheduledAt])
  @@map("notification_schedules")
}

model DriveEligibleBranch {
  driveId  String         @map("drive_id")
  drive    PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  branchId Int            @map("branch_id")
  branch   Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([driveId, branchId])
  @@map("drive_eligible_branches")
}

model DriveEligibleBatch {
  driveId String         @map("drive_id")
  drive   PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  batchId Int            @map("batch_id")
  batch   Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([driveId, batchId])
  @@map("drive_eligible_batches")
}

model DriveApplication {
  id                        String            @id @default(uuid())
  driveId                   String            @map("drive_id")
  drive                     PlacementDrive    @relation(fields: [driveId], references: [id], onDelete: Restrict)
  studentId                 String            @map("student_id")
  student                   User              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status                    ApplicationStatus @default(applied)
  eligibilityOverrideReason String?           @map("eligibility_override_reason")
  overriddenBy              String?           @map("overridden_by")
  appliedAt                 DateTime          @default(now()) @map("applied_at")
  withdrawnAt               DateTime?         @map("withdrawn_at")
  withdrawalReason          String?           @map("withdrawal_reason")
  resumeVersionId           String?           @map("resume_version_id")
  resumeVersion             ResumeVersion?    @relation(fields: [resumeVersionId], references: [id])
  resumeLabelAtSubmit       String?           @map("resume_label_at_submit")
  updatedAt                 DateTime          @updatedAt @map("updated_at")

  activities                ApplicationActivityLog[]
  rounds                    ApplicationRoundProgress[]
  mockInterviews            MockInterview[]
  offers                    Offer[]

  @@unique([driveId, studentId]) // DB-level duplicate prevention (Challenge 8/18)
  @@index([driveId])
  @@index([studentId])
  @@index([driveId, status])
  @@index([studentId, status])
  @@map("drive_applications")
}

model DriveChangeHistory {
  id            String          @id @default(uuid())
  driveId       String          @map("drive_id")
  drive         PlacementDrive  @relation(fields: [driveId], references: [id], onDelete: Cascade)
  changedBy     String          @map("changed_by")
  changeType    DriveChangeType @map("change_type")
  previousValue Json?           @map("previous_value")
  newValue      Json?           @map("new_value")
  changedAt     DateTime        @default(now()) @map("changed_at")

  @@index([driveId])
  @@map("drive_change_history")
}

model RecruitmentRound {
  id        String   @id @default(uuid())
  driveId   String   @map("drive_id")
  drive     PlacementDrive @relation(fields: [driveId], references: [id], onDelete: Cascade)
  name      String   // e.g., "Online Assessment", "Technical Interview"
  order     Int      // 1, 2, 3...
  createdAt DateTime @default(now()) @map("created_at")

  progress  ApplicationRoundProgress[]

  @@unique([driveId, name])
  @@index([driveId, order])
  @@map("recruitment_rounds")
}

model ApplicationRoundProgress {
  id            String           @id @default(uuid())
  applicationId String           @map("application_id")
  application   DriveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  roundId       String           @map("round_id")
  round         RecruitmentRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  status        RoundStatus      @default(pending)
  scheduledAt   DateTime?        @map("scheduled_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  @@unique([applicationId, roundId])
  @@index([applicationId])
  @@index([roundId])
  @@index([applicationId, status]) // Challenge 294: Composite index for fast application round progress lookup
  @@map("application_round_progress")
}

model ApplicationActivityLog {
  id             String           @id @default(uuid())
  applicationId  String           @map("application_id")
  application    DriveApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  action         String           // submitted, shortlisted, round_qualified, selected, withdrawn
  previousStatus String?          @map("previous_status")
  newStatus      String?          @map("new_status")
  actorId        String           @map("actor_id")
  details        Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([applicationId])
  @@map("application_activity_logs")
}

model Offer {
  id                 String            @id @default(uuid())
  studentId          String            @map("student_id")
  student            User              @relation("OfferStudent", fields: [studentId], references: [id], onDelete: Cascade)
  companyId          String            @map("company_id")
  company            Company           @relation("OfferCompany", fields: [companyId], references: [id], onDelete: Cascade)
  driveId            String?           @map("drive_id")
  drive              PlacementDrive?   @relation(fields: [driveId], references: [id], onDelete: Restrict)
  applicationId      String?           @map("application_id")
  application        DriveApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  jobRole            String            @map("job_role")
  employmentType     EmploymentType    @map("employment_type")
  offerDate          DateTime          @map("offer_date")
  joiningDate        DateTime?         @map("joining_date")
  acceptanceDeadline DateTime?         @map("acceptance_deadline")
  ctc                Float?
  fixedSalary        Float?            @map("fixed_salary")
  variablePay        Float?            @map("variable_pay")
  monthlySalary      Float?            @map("monthly_salary")
  stipend            Float?
  currency           String            @default("INR")
  offerLetterUrl     String?           @map("offer_letter_url")
  offerRefNumber     String?           @map("offer_ref_number")
  source             String            @default("on_campus") @map("source") // on_campus, off_campus
  status             OfferStatus       @default(issued)
  isVerified         Boolean           @default(false) @map("is_verified")
