  completedAt    DateTime?        @map("completed_at")
  recordsFetched Int              @default(0) @map("records_fetched")
  recordsCreated Int              @default(0) @map("records_created")
  errorSummary   String?          @map("error_summary")
  initiatedBy    String           @map("initiated_by")

  @@index([providerId, status])
  @@map("resource_sync_jobs")
}

model ResourceBookmark {
  id         String           @id @default(uuid())
