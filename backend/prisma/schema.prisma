enum TrainingResourceType {
  course
  dataset
  coding_challenge
  aptitude_test
  interview_question
  industry_report
  project_idea
}

enum SyncStatus {
  pending
  running
  success
  failed
}

model TrainingResource {
  id           String               @id @default(uuid())
  title        String
  description  String?
  resourceType TrainingResourceType @map("resource_type")
  provider     String? // e.g., "NPTEL", "Kaggle", "Internal"
  externalUrl  String?              @map("external_url")
  category     String? // e.g., "AI", "DSA", "Cloud"
  difficulty   String? // Beginner, Intermediate, Advanced
  accessType   String               @default("Free") @map("access_type") // Free, Paid
