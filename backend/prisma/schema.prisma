  @@map("interviewer_availability")
}

model MockInterview {
  id                  String                     @id @default(uuid())
  studentId           String                     @map("student_id")
  student             User                       @relation("InterviewStudent", fields: [studentId], references: [id])
  interviewerId       String                     @map("interviewer_id")
  interviewer         User                       @relation("Interviewer", fields: [interviewerId], references: [id])
  type                InterviewType              @default(technical)
  status              InterviewStatus            @default(scheduled)
  startTime           DateTime                   @map("start_time")
  endTime             DateTime                   @map("end_time")
  meetingLink         String?                    @map("meeting_link")
  rubricId            String?                    @map("rubric_id")
  rubric              InterviewRubric?           @relation(fields: [rubricId], references: [id])
  applicationId       String?                    @map("application_id")
  application         DriveApplication?          @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  cancellationReason  String?                    @map("cancellation_reason")
  createdBy           String                     @map("created_by")
  createdAt           DateTime                   @default(now()) @map("created_at")
  updatedAt           DateTime                   @updatedAt @map("updated_at")

  feedback            InterviewFeedback?
  history             InterviewSessionHistory[]
  rescheduleRequests  InterviewRescheduleRequest[]

  @@unique([studentId, startTime, type]) // Ch 127: prevents duplicate appointments
  @@unique([interviewerId, startTime])   // Ch 127: prevents interviewer double-booking
  @@index([studentId, status])
  @@index([interviewerId, status])
  @@map("mock_interviews")
}

model InterviewSessionHistory {
  id          String          @id @default(uuid())
  interviewId String          @map("interview_id")
  interview   MockInterview   @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  action      String          // schedule, reschedule, cancel, interrupt, resume, complete
  details     Json?
  actorId     String          @map("actor_id")
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([interviewId])
  @@map("interview_session_history")
}

model InterviewFeedback {
  id                String         @id @default(uuid())
  interviewId       String?        @unique @map("interview_id")
  interview         MockInterview? @relation(fields: [interviewId], references: [id], onDelete: SetNull)
  scores            Json          // { technical: 8, communication: 7, ... }
  studentComments   String        @map("student_comments")
  confidentialNotes String?       @map("confidential_notes")
  isFinalized       Boolean       @default(false) @map("is_finalized")
  evaluatedBy       String        @map("evaluated_by")
  evaluatedAt       DateTime      @default(now()) @map("evaluated_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([interviewId]) // Challenge 294: Explicit index on interview feedback
  @@map("interview_feedback")
}

model InterviewRescheduleRequest {
  id            String        @id @default(uuid())
  interviewId   String        @map("interview_id")
  interview     MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  requestedBy   String        @map("requested_by")
  reason        String
  proposedTime  DateTime      @map("proposed_time")
  status        String        @default("pending") // pending, approved, rejected
  reviewedBy    String?       @map("reviewed_by")
  reviewedAt    DateTime?     @map("reviewed_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  @@index([status])
  @@map("interview_reschedule_requests")
}

