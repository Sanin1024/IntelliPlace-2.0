# Database
DATABASE_URL="postgresql://intelliplace:intelliplace_dev_only@localhost:5433/intelliplace"

# Server
PORT=4000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="replace-with-a-real-64-byte-hex-secret"
JWT_EXPIRES_IN="7d"

# Rate Limiting & Proxy
RATE_LIMIT_ENFORCE=false
# Login Rate Limiting: 10 failed attempts per 15-minute window (successful logins do not consume allowance)
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
# Registration Rate Limiting: 20 accounts per 15-minute window in dev, 10 in prod
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=900000
AUTH_REGISTER_RATE_LIMIT_MAX=20
# Reverse Proxy Trust (set to true only when behind a trusted reverse proxy like Nginx or Cloudflare)
TRUST_PROXY=false

# Code Runner Configuration
# IMPORTANT: Plain child process is NOT a sandbox. Environment stripping and timeouts
# stop accidents, but executed code can still read files the OS user can read.
# Local or demo machine only. OFF by default.
CODE_RUNNER_ENABLED=false
CODE_RUNNER_LANGUAGES=python,javascript
PYTHON_BIN=python
NODE_BIN=node
CODE_TIME_LIMIT_MS=2000
CODE_OUTPUT_LIMIT_BYTES=65536
CODE_MAX_SOURCE_BYTES=20000