{
  "name": "intelliplace",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "seed": "npm run seed --workspace backend",
    "seed:reset": "npm run seed:reset --workspace backend",
    "seed:demo": "npm run seed:demo --workspace backend",
    "demo:reset": "npm run demo:reset --workspace backend",
    "validate:content": "npm run validate:content --workspace backend",
    "db:counts": "npm run db:counts --workspace backend",
    "e2e": "npm run e2e --workspace backend",
    "smoke": "npm run smoke --workspace frontend"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "esbuild": true,
    "prisma@7.10.1": true
  }
}
